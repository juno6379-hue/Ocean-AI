ENVIRONMENT=development
DATABASE_URL=postgresql://ocean_ai_user:change-me@127.0.0.1:5432/ocean_ai_db
TEST_DATABASE_URL=sqlite://
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# Explicit runtime switches; keep MDC disabled until the source DB is verified.
DATA_MODE=live
MDC_SYNC_ENABLED=false
AUTO_CREATE_TABLES=false
VECTOR_SEARCH_ENABLED=true
# 문서 수집과 검색은 동일한 단일 Chroma 서버를 사용한다.
DOCUMENT_CHROMA_HOST=127.0.0.1
DOCUMENT_CHROMA_PORT=8001
DOCUMENT_CHROMA_SSL=false
DATASET_SNAPSHOT_DIR=data/dataset_snapshots
# Per-user identities: configure unique random tokens on the server.
API_IDENTITIES={}
MDC_DSN=
MDC_USER=
MDC_PWD=
ORACLE_CLIENT_LIB_DIR=

# Replace this local-only example before running PostgreSQL.
POSTGRES_PASSWORD=change-me
